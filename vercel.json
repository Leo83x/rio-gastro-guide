{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/outscraper/:subpath*",
      "destination": "/api/outscraper?__subpath=:subpath*"
    },
    {
      "source": "/api/nightlife/:action*",
      "destination": "/api/nightlife?__action=:action*"
    },
    {
      "source": "/api/billing/:action*",
      "destination": "/api/billing?__action=:action*"
    },
    {
      "source": "/api/referrals/:action*",
      "destination": "/api/referrals?__action=:action*"
    },
    {
      "source": "/api/integrity/:action*",
      "destination": "/api/integrity?__action=:action*"
    },
    {
      "source": "/((?!api/|assets/|brand/|sw\\.js$|manifest\\.webmanifest$|favicon\\.svg$|icons\\.svg$|robots\\.txt$).*)",
      "destination": "/index.html"
    }
  ]
}
