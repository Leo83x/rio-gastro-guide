# BoraRio — Variáveis de Ambiente (Exemplo sem chaves reais)
# Copie para .env.local para desenvolvimento ou configure em Environment Variables na Vercel.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chaves exclusivamente Server-Side (Vercel Serverless /api/*)
OUTSCRAPER_API_KEY=
SYMPLA_API_TOKEN=
INGRESSE_API_KEY=
# Supabase Admin (necessário para que aprovações do /admin gravem no banco global para todos os usuários)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gateway de Pagamento de Faturas do Parceiro (Server-Side /api/billing/*)
# Escolha 'pagarme' ou 'stripe' e preencha a respectiva chave secreta
PAYMENT_PROVIDER=pagarme
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
