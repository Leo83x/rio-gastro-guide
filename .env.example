# Opcional: configure para usar persistência em nuvem via Supabase PostgreSQL + Auth.
# Sem essas variáveis, o BoraRio funciona imediatamente em armazenamento local seguro.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: endpoint proxy backend (ou Edge Function Supabase) para análise de links/OCR do Cofre de Intenções e Bora IA.
VITE_BORARIO_AI_PROXY_URL=

# Outscraper API (https://app.outscraper.cloud/api-docs)
# IMPORTANTE: mantenha OUTSCRAPER_API_KEY apenas no backend/proxy/CLI (nunca prefixe com VITE_).
OUTSCRAPER_API_KEY=
# Opcional em produção (ex.: https://<seu-projeto>.supabase.co/functions/v1/outscraper-proxy)
# No Vite local/preview e na Vercel (api/outscraper.ts), o proxy /api/outscraper já é integrado automaticamente.
VITE_BORARIO_OUTSCRAPER_PROXY_URL=
